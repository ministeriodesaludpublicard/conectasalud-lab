# ConectaSalud Lab · Configuración de ejemplo, sin información privada
# Copie este archivo como .env y configure los servidores en su entorno.

NODE_ENV=production
PORT=3445
MAX_BODY_SIZE_MB=20

# HAPI FHIR local o sandbox autorizado. No utilice IPs de producción aquí.
HAPI_FHIR_NAME=Servidor FHIR de pruebas
HAPI_FHIR_URL=http://127.0.0.1:8080/fhir
# Ejemplo: [{"id":"registry","name":"Índices","url":"https://fhir.example.org/fhir","role":"registry"}]
FHIR_SERVERS_JSON=[]
FHIR_BEARER_TOKEN=
FHIR_FETCH_ALLOWED_HOSTS=

# Validación FHIR (la conformidad con la IG requiere instalar el paquete correspondiente)
FHIR_VALIDATION_URL=http://127.0.0.1:8080/fhir
FHIR_VALIDATION_BEARER_TOKEN=
FHIR_GUIDE_URL=https://digital.msp.gob.do/fhir/conectaton/
FHIR_GUIDE_VERSION=0.2.0

# OpenHIM y mediador documental
OPENHIM_BASE_URL=https://openhim.example.org:5000
OPENHIM_TIMEOUT_MS=90000
OPENHIM_TLS_REJECT_UNAUTHORIZED=true
OPENHIM_USERNAME=
OPENHIM_PASSWORD=
OPENHIM_PUBLISH_USERNAME=
OPENHIM_PUBLISH_PASSWORD=
DOCUMENT_PUBLISH_PATH=/transaction
DOCUMENT_SEARCH_PATH=/DocumentReference
DOCUMENT_SEARCH_PATIENT_IDENTIFIER_PARAM=patient.identifier
DOCUMENT_SEARCH_STATUS_PARAM=status
DOCUMENT_SEARCH_TYPE_PARAM=type
DOCUMENT_RETRIEVE_PATH_TEMPLATE=/documents/{documentId}

# Emisor institucional de JWT: servicio privado, nunca expuesto en el navegador
OPENHIM_TOKEN_URL=https://auth.example.org/auth/token
OPENHIM_CLIENT_ID=
OPENHIM_CLIENT_SECRET=
OPENHIM_JWT=
ITI65_TEST_TOKEN=
MPI_BEARER_TOKEN=
MPI_PASSWORD=

# Auditoría, repositorios y explorador
LOG_DIR=
GENERATED_DIR=
DOCUMENT_EXPLORER_ALLOW_GLOBAL=false
PATIENT_IDENTIFIER_SYSTEMS_JSON=
FHIR_EXPLORER_TOKENS_JSON=
