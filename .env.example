# Servidor web de ConectaSalud Lab
PORT=3445
MAX_BODY_SIZE_MB=20

# Servidor FHIR R4 inicial. Debe ser accesible desde el backend.
HAPI_FHIR_NAME=Servidor FHIR local
HAPI_FHIR_URL=http://localhost:8080/fhir

# Servidores adicionales administrados por el despliegue (JSON en una línea).
# Ejemplo: [{"id":"sandbox-1","name":"Sandbox institucional","url":"https://fhir.example.org/fhir"}]
FHIR_SERVERS_JSON=

# Autenticación opcional. No incorpore el archivo .env al repositorio.
FHIR_BEARER_TOKEN=

# Hosts internos adicionales permitidos para "Cargar desde URL", separados por coma.
FHIR_FETCH_ALLOWED_HOSTS=

# Identificador real de la institución que publica mediante ITI-65 (OID, URI o URN).
MHD_SOURCE_ID=

# Guía de implementación mostrada en la interfaz.
FHIR_GUIDE_URL=https://igrepdom.netlify.app/
FHIR_GUIDE_VERSION=

# Directorios opcionales. Vacíos utilizan ./logs y ./generated.
LOG_DIR=
GENERATED_DIR=
